<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentplatform</groupId>
        <artifactId>agent-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-platform-web</artifactId>
    <name>Agent Platform - Web</name>
    <description>Web模块（REST API、前端）</description>

    <dependencies>
        <!-- 内部核心模块 -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>agent-platform-core</artifactId>
        </dependency>

        <!-- 内部执行器模块 -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>agent-platform-executor</artifactId>
        </dependency>

        <!-- 内部调度模块 -->
        <dependency>
            <groupId>com.agentplatform</groupId>
            <artifactId>agent-platform-scheduler</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
